# Line endings: files that Linux containers run or read always stay LF,
# even on Windows with core.autocrlf=true.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.mako text eol=lf
*.py text eol=lf
.dockerignore text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
