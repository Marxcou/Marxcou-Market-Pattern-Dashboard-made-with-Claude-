# IMPORTANT: comments go on their own lines, never after a value (Docker Compose would take them as part of the value).
# Copy this file to ".env" in the project root (next to docker-compose.yml):
#   cp .env.example .env
# The ".env" file is never committed (.gitignore). Never put keys into code or into a chat.

# --- General ---
# development | production
APP_ENV=development
# true = explicitly labeled sample data (never mixed with real data)
DEMO_MODE=false
TIMEZONE=Europe/Berlin
DATABASE_URL=sqlite:////data/marktmuster.db
# Port on which the dashboard is reachable locally
WEB_PORT=8080

# --- Login / sessions ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
# true as soon as HTTPS is used (server operation)
COOKIE_SECURE=false
# Only for server operation with a public HTTPS address (path B, see docs/operations.md): domain whose A record points at the server. Leave empty for local and Tailscale.
DOMAIN=
# First administrator (created at startup if no admin exists yet). Registration is possible only by invitation from an admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Price data (phase 1B) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
STOOQ_API_KEY=
# optional
OPENFIGI_API_KEY=
# EODHD_API_KEY=                    # later upgrade for XETRA intraday (not in the free plan)
# optional, unofficial: daily data for US/XETRA, e.g. when there is no Stooq key
YAHOO_ENABLED=false

# Cache of daily data for the pattern backtest (phase 3C)
BACKTEST_CACHE_DIR=/data/backtest-cache

# --- News (phase 2) ---
# Required in the user agent for SEC EDGAR
SEC_EDGAR_CONTACT_EMAIL=
MARKETAUX_API_KEY=
# optional
ALPHAVANTAGE_API_KEY=
# Feeds are off until you enable them. Check the feed address and terms of use first (see the Sources page).
# e.g. tagesschau,cnbc,marketwatch,handelsblatt or all
RSS_ENABLED_FEEDS=
# Investor relations feeds: AAPL|https://.../feed.xml,SAP.DE|https://.../rss (https only), check the terms of use
IR_FEEDS=
# Feed address of EQS news (ad-hoc announcements), check the terms of use
EQS_RSS_URL=

# --- AI (phase 2C / 4C, optional) ---
ANTHROPIC_API_KEY=
# hard cap, after which the lexicon fallback is used
CLAUDE_MONTHLY_BUDGET_USD=10
# Sentiment via batch API (half price, result after minutes to hours)
CLAUDE_USE_BATCH=true
# delete older items (minimum 14; 0 = never delete)
NEWS_RETENTION_DAYS=90
